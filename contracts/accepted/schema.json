{
  "$defs": {
    "AstroPassportRequestV1": {
      "additionalProperties": false,
      "properties": {
        "civil": {
          "$ref": "#/$defs/CivilInput"
        },
        "contract_version": {
          "const": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "profile": {
          "const": "sun-moon.v1",
          "title": "Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "AstroPassportRequest.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_place": {
          "$ref": "#/$defs/SelectedPlace"
        }
      },
      "required": [
        "schema_version",
        "contract_version",
        "profile",
        "selected_place",
        "civil"
      ],
      "title": "AstroPassportRequestV1",
      "type": "object"
    },
    "AstroPassportResponseV1": {
      "additionalProperties": false,
      "properties": {
        "authenticity": {
          "const": "unsigned-direct-client-only",
          "title": "Authenticity",
          "type": "string"
        },
        "bodies": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/SunLongitude"
            },
            {
              "$ref": "#/$defs/MoonLongitude"
            }
          ],
          "title": "Bodies",
          "type": "array"
        },
        "boundary": {
          "$ref": "#/$defs/BoundaryFact"
        },
        "civil": {
          "$ref": "#/$defs/CivilFact"
        },
        "civil_input": {
          "$ref": "#/$defs/CivilInput"
        },
        "contract_version": {
          "const": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "profile": {
          "const": "sun-moon.v1",
          "title": "Profile",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceV1"
        },
        "schema_version": {
          "const": "AstroPassportResponse.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_place": {
          "$ref": "#/$defs/SelectedPlace"
        },
        "serialization": {
          "const": "astro-passport-json.v1",
          "title": "Serialization",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_version",
        "profile",
        "selected_place",
        "civil_input",
        "boundary",
        "civil",
        "bodies",
        "provenance",
        "serialization",
        "authenticity"
      ],
      "title": "AstroPassportResponseV1",
      "type": "object"
    },
    "BoundaryFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "timezone-boundary.v1"
        },
        "outcome": {
          "const": "unique"
        },
        "iana_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenance": {
          "$ref": "#/$defs/BoundaryProvenance"
        }
      },
      "required": [
        "schema_version",
        "outcome",
        "iana_zone",
        "provenance"
      ]
    },
    "CivilFact": {
      "additionalProperties": false,
      "properties": {
        "fold": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fold"
        },
        "offset_seconds": {
          "exclusiveMaximum": 86400,
          "exclusiveMinimum": -86400,
          "title": "Offset Seconds",
          "type": "integer"
        },
        "resolution": {
          "enum": [
            "unique",
            "explicit_fold"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "title": "Utc",
          "type": "string"
        },
        "schema_version": {
          "const": "civil-time.v1"
        },
        "provenance": {
          "$ref": "#/$defs/CivilProvenance"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "fold",
        "offset_seconds",
        "resolution",
        "utc",
        "schema_version",
        "provenance",
        "limitations"
      ],
      "title": "CivilFact",
      "type": "object"
    },
    "CivilInput": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Date",
          "type": "string"
        },
        "fold": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fold"
        },
        "time": {
          "pattern": "^[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]{1,6})?)?$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "date",
        "time",
        "fold"
      ],
      "title": "CivilInput",
      "type": "object"
    },
    "ErrorEnvelopeV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "disabled",
            "unauthorized",
            "forbidden",
            "invalid_request",
            "unsupported_version",
            "too_large",
            "unsupported_media_type",
            "rate_limited",
            "busy",
            "state_unavailable",
            "science_unavailable",
            "timeout",
            "internal_error",
            "boundary_ambiguous",
            "boundary_no_match",
            "civil_ambiguous",
            "civil_nonexistent",
            "artifact_unavailable",
            "artifact_integrity",
            "boundary_boundary",
            "invalid_fold",
            "unsupported_runtime",
            "artifact_invalid",
            "native_failure",
            "fallback_rejected",
            "invalid_result"
          ],
          "title": "Code",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_version": {
          "const": "AstroPassportError.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "contract_version",
        "schema_version"
      ],
      "title": "ErrorEnvelopeV1",
      "type": "object"
    },
    "Longitude": {
      "additionalProperties": false,
      "properties": {
        "binary64_hex": {
          "maxLength": 32,
          "minLength": 8,
          "title": "Binary64 Hex",
          "type": "string"
        },
        "body": {
          "enum": [
            "sun",
            "moon"
          ],
          "title": "Body",
          "type": "string"
        },
        "decimal_degrees": {
          "pattern": "^(?:0|[1-9][0-9]?|[12][0-9]{2}|3[0-5][0-9])\\.[0-9]{9}$",
          "title": "Decimal Degrees",
          "type": "string"
        }
      },
      "required": [
        "body",
        "binary64_hex",
        "decimal_degrees"
      ],
      "title": "Longitude",
      "type": "object"
    },
    "ProvenanceV1": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "enum": [
            "swiss-isolated.v1"
          ]
        },
        "binding": {
          "type": "string",
          "enum": [
            "pysweph-2.10.3.6"
          ]
        },
        "library": {
          "type": "string",
          "enum": [
            "2.10.03"
          ]
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "planet_data_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "moon_data_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_origin": {
          "type": "string",
          "enum": [
            "DE441"
          ]
        },
        "requested_flags": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "returned_flags": {
          "type": "array",
          "prefixItems": [
            {
              "const": 2
            },
            {
              "const": 2
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "projection": {
          "type": "string",
          "enum": [
            "geocentric-tropical-apparent-ecliptic-of-date"
          ]
        },
        "numerical_policy": {
          "type": "string",
          "enum": [
            "binary64-to-decimal-9dp-half-even.v1"
          ]
        },
        "time_policy": {
          "type": "string",
          "enum": [
            "pinned-leaps-2016-pre1972-ut1-proxy.v1"
          ]
        },
        "delta_t_policy": {
          "type": "string",
          "enum": [
            "swiss-2.10.03-auto-model-tidal-DE441"
          ]
        },
        "runtime": {
          "type": "string",
          "enum": [
            "CPython-3.12.14-Linux-x86_64"
          ]
        },
        "schema_version": {
          "const": "AstroPassportProvenance.v1"
        },
        "source_repository": {
          "const": "https://github.com/Attory/astro-passport"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ephemeris_schema": {
          "const": "ephemeris.v1"
        },
        "tt_jd_binary64": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32
        },
        "ut1_jd_binary64": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "adapter",
        "binding",
        "library",
        "binary_sha256",
        "binding_source_sha256",
        "planet_data_sha256",
        "moon_data_sha256",
        "data_origin",
        "requested_flags",
        "returned_flags",
        "projection",
        "numerical_policy",
        "time_policy",
        "delta_t_policy",
        "runtime",
        "schema_version",
        "source_repository",
        "source_revision",
        "ephemeris_schema",
        "tt_jd_binary64",
        "ut1_jd_binary64",
        "limitations"
      ],
      "additionalProperties": false
    },
    "SelectedPlace": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribution"
        },
        "display_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "provider": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Provider",
          "type": "string"
        },
        "query": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "requested_limit": {
          "maximum": 10,
          "minimum": 1,
          "title": "Requested Limit",
          "type": "integer"
        },
        "result_count": {
          "maximum": 10,
          "minimum": 1,
          "title": "Result Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "SelectedPlaceInput.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_index": {
          "maximum": 9,
          "minimum": 0,
          "title": "Selected Index",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "provider",
        "source_id",
        "display_name",
        "latitude",
        "longitude",
        "attribution",
        "query",
        "requested_limit",
        "selected_index",
        "result_count"
      ],
      "title": "SelectedPlace",
      "type": "object"
    },
    "BoundaryProvenance": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "enum": [
            "timezone-boundary-builder"
          ]
        },
        "release": {
          "type": "string",
          "enum": [
            "2026c"
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "comprehensive-no-oceans"
          ]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resolver": {
          "type": "string",
          "enum": [
            "tbb-planar.v1"
          ]
        },
        "shapely_version": {
          "type": "string",
          "enum": [
            "2.1.2"
          ]
        },
        "geos_version": {
          "type": "string",
          "enum": [
            "3.13.1"
          ]
        },
        "numpy_version": {
          "type": "string",
          "enum": [
            "2.5.3"
          ]
        },
        "python_version": {
          "type": "string",
          "enum": [
            "3.12.14"
          ]
        },
        "execution_target": {
          "type": "string",
          "enum": [
            "linux-amd64"
          ]
        },
        "license": {
          "type": "string",
          "enum": [
            "ODbL-1.0"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "license_url": {
          "type": "string",
          "enum": [
            "https://opendatacommons.org/licenses/odbl/1-0/"
          ]
        }
      },
      "required": [
        "dataset",
        "release",
        "variant",
        "manifest_sha256",
        "archive_sha256",
        "geometry_sha256",
        "catalog_sha256",
        "resolver",
        "shapely_version",
        "geos_version",
        "numpy_version",
        "python_version",
        "execution_target",
        "license",
        "attribution",
        "license_url"
      ],
      "additionalProperties": false
    },
    "CivilProvenance": {
      "type": "object",
      "properties": {
        "iana_version": {
          "type": "string",
          "enum": [
            "2026c"
          ]
        },
        "build_policy": {
          "type": "string",
          "enum": [
            "main-backzone-zone.tab-posix-slim.v1"
          ]
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tzdata_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tzcode_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tzif_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resolver": {
          "type": "string",
          "enum": [
            "zoneinfo-roundtrip.v1"
          ]
        },
        "python_runtime": {
          "type": "string",
          "enum": [
            "CPython-3.12.14"
          ]
        },
        "calendar": {
          "type": "string",
          "enum": [
            "proleptic-gregorian"
          ]
        },
        "utc_convention": {
          "type": "string",
          "enum": [
            "posix-no-leap-seconds"
          ]
        },
        "historical_assurance": {
          "type": "string",
          "enum": [
            "pinned-dataset-rules-only"
          ]
        }
      },
      "required": [
        "iana_version",
        "build_policy",
        "archive_sha256",
        "tzdata_source_sha256",
        "tzcode_source_sha256",
        "tzif_sha256",
        "resolver",
        "python_runtime",
        "calendar",
        "utc_convention",
        "historical_assurance"
      ],
      "additionalProperties": false
    },
    "SunLongitude": {
      "additionalProperties": false,
      "properties": {
        "binary64_hex": {
          "maxLength": 32,
          "minLength": 8,
          "title": "Binary64 Hex",
          "type": "string"
        },
        "body": {
          "const": "sun",
          "type": "string"
        },
        "decimal_degrees": {
          "pattern": "^(?:0|[1-9][0-9]?|[12][0-9]{2}|3[0-5][0-9])\\.[0-9]{9}$",
          "title": "Decimal Degrees",
          "type": "string"
        }
      },
      "required": [
        "body",
        "binary64_hex",
        "decimal_degrees"
      ],
      "title": "Longitude",
      "type": "object"
    },
    "MoonLongitude": {
      "additionalProperties": false,
      "properties": {
        "binary64_hex": {
          "maxLength": 32,
          "minLength": 8,
          "title": "Binary64 Hex",
          "type": "string"
        },
        "body": {
          "const": "moon",
          "type": "string"
        },
        "decimal_degrees": {
          "pattern": "^(?:0|[1-9][0-9]?|[12][0-9]{2}|3[0-5][0-9])\\.[0-9]{9}$",
          "title": "Decimal Degrees",
          "type": "string"
        }
      },
      "required": [
        "body",
        "binary64_hex",
        "decimal_degrees"
      ],
      "title": "Longitude",
      "type": "object"
    }
