{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "license": {
          "maxLength": 128,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "version",
        "sha256",
        "license"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "AstroPassportRequestV1": {
      "additionalProperties": false,
      "properties": {
        "civil": {
          "$ref": "#/$defs/CivilInput"
        },
        "contract_version": {
          "const": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "profile": {
          "const": "sun-moon.v1",
          "title": "Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "AstroPassportRequest.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_place": {
          "$ref": "#/$defs/SelectedPlace"
        }
      },
      "required": [
        "schema_version",
        "contract_version",
        "profile",
        "selected_place",
        "civil"
      ],
      "title": "AstroPassportRequestV1",
      "type": "object"
    },
    "AstroPassportResponseV1": {
      "additionalProperties": false,
      "properties": {
        "authenticity": {
          "const": "unsigned-direct-client-only",
          "title": "Authenticity",
          "type": "string"
        },
        "bodies": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Longitude"
            },
            {
              "$ref": "#/$defs/Longitude"
            }
          ],
          "title": "Bodies",
          "type": "array"
        },
        "boundary": {
          "$ref": "#/$defs/BoundaryFact"
        },
        "civil": {
          "$ref": "#/$defs/CivilFact"
        },
        "civil_input": {
          "$ref": "#/$defs/CivilInput"
        },
        "contract_version": {
          "const": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "profile": {
          "const": "sun-moon.v1",
          "title": "Profile",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceV1"
        },
        "schema_version": {
          "const": "AstroPassportResponse.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_place": {
          "$ref": "#/$defs/SelectedPlace"
        },
        "serialization": {
          "const": "astro-passport-json.v1",
          "title": "Serialization",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_version",
        "profile",
        "selected_place",
        "civil_input",
        "boundary",
        "civil",
        "bodies",
        "provenance",
        "serialization",
        "authenticity"
      ],
      "title": "AstroPassportResponseV1",
      "type": "object"
    },
    "BoundaryFact": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "$ref": "#/$defs/Artifact"
        },
        "iana_zone": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)+$",
          "title": "Iana Zone",
          "type": "string"
        },
        "outcome": {
          "const": "unique",
          "title": "Outcome",
          "type": "string"
        },
        "resolver": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resolver",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "iana_zone",
        "dataset",
        "resolver"
      ],
      "title": "BoundaryFact",
      "type": "object"
    },
    "CivilFact": {
      "additionalProperties": false,
      "properties": {
        "fold": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fold"
        },
        "offset_seconds": {
          "exclusiveMaximum": 86400,
          "exclusiveMinimum": -86400,
          "title": "Offset Seconds",
          "type": "integer"
        },
        "resolution": {
          "enum": [
            "unique",
            "explicit_fold"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "resolver": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resolver",
          "type": "string"
        },
        "tzdata": {
          "$ref": "#/$defs/Artifact"
        },
        "tzif_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tzif Sha256",
          "type": "string"
        },
        "utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "utc",
        "offset_seconds",
        "resolution",
        "fold",
        "tzdata",
        "tzif_sha256",
        "resolver"
      ],
      "title": "CivilFact",
      "type": "object"
    },
    "CivilInput": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Date",
          "type": "string"
        },
        "fold": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fold"
        },
        "time": {
          "pattern": "^[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]{1,6})?)?$",
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "date",
        "time",
        "fold"
      ],
      "title": "CivilInput",
      "type": "object"
    },
    "ErrorEnvelopeV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "disabled",
            "unauthorized",
            "forbidden",
            "invalid_request",
            "unsupported_version",
            "too_large",
            "unsupported_media_type",
            "rate_limited",
            "busy",
            "state_unavailable",
            "science_unavailable",
            "timeout",
            "internal_error",
            "boundary_ambiguous",
            "boundary_no_match",
            "civil_ambiguous",
            "civil_nonexistent",
            "artifact_unavailable",
            "artifact_integrity"
          ],
          "title": "Code",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_version": {
          "const": "AstroPassportError.v1",
          "default": "AstroPassportError.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ErrorEnvelopeV1",
      "type": "object"
    },
    "Longitude": {
      "additionalProperties": false,
      "properties": {
        "binary64_hex": {
          "maxLength": 32,
          "minLength": 8,
          "title": "Binary64 Hex",
          "type": "string"
        },
        "body": {
          "enum": [
            "sun",
            "moon"
          ],
          "title": "Body",
          "type": "string"
        },
        "decimal_degrees": {
          "pattern": "^[0-9]{1,3}\\.[0-9]{9}$",
          "title": "Decimal Degrees",
          "type": "string"
        }
      },
      "required": [
        "body",
        "binary64_hex",
        "decimal_degrees"
      ],
      "title": "Longitude",
      "type": "object"
    },
    "ProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/Artifact"
        },
        "data_files": {
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Data Files",
          "type": "array"
        },
        "ephemeris_flags": {
          "const": 2,
          "title": "Ephemeris Flags",
          "type": "integer"
        },
        "limitations": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "native_binary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Native Binary Sha256",
          "type": "string"
        },
        "native_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Native Version",
          "type": "string"
        },
        "numerical_policy": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Numerical Policy",
          "type": "string"
        },
        "projection": {
          "const": "geocentric-tropical-apparent-ecliptic-of-date",
          "title": "Projection",
          "type": "string"
        },
        "runtime_identity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Identity",
          "type": "string"
        },
        "schema_version": {
          "const": "AstroPassportProvenance.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_repository": {
          "const": "https://github.com/Attory/astro-passport",
          "title": "Source Repository",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "time_scale_policy": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Time Scale Policy",
          "type": "string"
        },
        "tt_jd_binary64": {
          "maxLength": 32,
          "minLength": 8,
          "title": "Tt Jd Binary64",
          "type": "string"
        },
        "ut1_jd_binary64": {
          "maxLength": 32,
          "minLength": 8,
          "title": "Ut1 Jd Binary64",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_repository",
        "source_revision",
        "runtime_identity",
        "binding",
        "native_version",
        "native_binary_sha256",
        "data_files",
        "ephemeris_flags",
        "projection",
        "numerical_policy",
        "time_scale_policy",
        "tt_jd_binary64",
        "ut1_jd_binary64",
        "limitations"
      ],
      "title": "ProvenanceV1",
      "type": "object"
    },
    "SelectedPlace": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribution"
        },
        "display_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "provider": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Provider",
          "type": "string"
        },
        "query": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "requested_limit": {
          "maximum": 10,
          "minimum": 1,
          "title": "Requested Limit",
          "type": "integer"
        },
        "result_count": {
          "maximum": 10,
          "minimum": 1,
          "title": "Result Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "SelectedPlaceInput.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_index": {
          "maximum": 9,
          "minimum": 0,
          "title": "Selected Index",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "provider",
        "source_id",
        "display_name",
        "latitude",
        "longitude",
        "attribution",
        "query",
        "requested_limit",
        "selected_index",
        "result_count"
      ],
      "title": "SelectedPlace",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/Attory/astro-passport/astropassport-schema-v1.0.0/contracts/astropassport/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/AstroPassportRequestV1"
    },
    {
      "$ref": "#/$defs/AstroPassportResponseV1"
    },
    {
      "$ref": "#/$defs/ProvenanceV1"
    },
    {
      "$ref": "#/$defs/ErrorEnvelopeV1"
    }
  ]
}
